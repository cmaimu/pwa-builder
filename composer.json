{
    "name": "cmdimu/pwa-builder",
    "description": "Progressive Web App (PWA) Builder for Laravel, CodeIgniter 4, and CodeIgniter 3",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "cmdimu"
        }
    ],
    "keywords": [
        "pwa",
        "progressive-web-app",
        "service-worker",
        "manifest",
        "pwa-builder",
        "laravel",
        "codeigniter",
        "ci4",
        "ci3"
    ],
    "require": {
        "php": ">=7.4",
        "ext-json": "*",
        "ext-gd": "*",
        "vlucas/phpdotenv": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "PwaBuilder\\": "src/"
        },
        "files": [
            "src/Helpers/pwa_helper.php"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "PwaBuilder\\Adapters\\LaravelServiceProvider"
            ],
            "aliases": {
                "PwaBuilder": "PwaBuilder\\Facades\\PwaBuilder"
            }
        }
    }
}

